{
  "name": "wafar-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Wafar Asraa backend: WhatsApp bot now, app API later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "check": "biome ci . && tsc --noEmit && vitest run",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "migrate": "node --env-file-if-exists=../.env scripts/migrate.ts",
    "db:types": "kysely-codegen --env-file ../.env --dialect postgres --date-parser string --numeric-parser string --out-file src/db/schema.generated.ts",
    "db:check": "node --env-file-if-exists=../.env scripts/check-supabase.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
