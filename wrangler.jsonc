// Cloudflare Workers deploy for the Wafar Asraa web demo (the frontend in codebase/).
// Cloudflare runs `npx wrangler deploy` at the repo root: wrangler first runs
// build.command, then uploads codebase/dist as static assets.
// The backend (wafar-backend/) is not deployed here.
{
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "wafar-asraa",
  "compatibility_date": "2026-11-01",
  "build": {
    "command": "npm ci --prefix codebase && npm run build --prefix codebase"
  },
  "assets": {
    "directory": "./codebase/dist",
    // The app routes in the browser (react-router), so unknown paths get index.html.
    "not_found_handling": "single-page-application"
  }
}
