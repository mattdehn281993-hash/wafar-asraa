{
  "$comment": "Shared test cases for money helpers (backend/src/lib/money.ts). Amounts are integer piastres (1 EGP = 100). Any port (e.g. Rust) must pass every case.",
  "to_piastres": [
    { "input": 85.5, "expected": 8550 },
    { "input": 85.55, "expected": 8555 },
    { "input": 1250, "expected": 125000 },
    { "input": 0, "expected": 0 },
    { "input": 19.99, "expected": 1999 },
    { "input": 0.30000000000000004, "expected": 30, "note": "0.1 + 0.2 in floating point" },
    { "input": 1.005, "expected": 101, "note": "third decimal rounds half away from zero" },
    { "input": 1.0049, "expected": 100 },
    { "input": -12.5, "expected": -1250 }
  ],
  "from_numeric_string": [
    { "input": "1250.50", "expected": 125050 },
    { "input": "85.5", "expected": 8550 },
    { "input": "0", "expected": 0 },
    { "input": "0.00", "expected": 0 },
    { "input": "-3.00", "expected": -300 },
    { "input": "12.345", "expected": 1235 }
  ],
  "to_numeric_string": [
    { "input": 125050, "expected": "1250.50" },
    { "input": 8550, "expected": "85.50" },
    { "input": 5, "expected": "0.05" },
    { "input": 0, "expected": "0.00" },
    { "input": -300, "expected": "-3.00" }
  ],
  "parse_money_input": [
    { "input": "5000", "expected": { "ok": true, "piastres": 500000 } },
    { "input": "5,000", "expected": { "ok": true, "piastres": 500000 } },
    { "input": "٥٠٠٠", "expected": { "ok": true, "piastres": 500000 } },
    { "input": "5k", "expected": { "ok": true, "piastres": 500000 } },
    { "input": "5K", "expected": { "ok": true, "piastres": 500000 } },
    { "input": "5 k", "expected": { "ok": true, "piastres": 500000 } },
    { "input": "2.5k", "expected": { "ok": true, "piastres": 250000 } },
    { "input": "٥ آلاف", "expected": { "ok": true, "piastres": 500000 } },
    { "input": "5 الاف", "expected": { "ok": true, "piastres": 500000 } },
    { "input": "10 thousand", "expected": { "ok": true, "piastres": 1000000 } },
    { "input": "5000 EGP", "expected": { "ok": true, "piastres": 500000 } },
    { "input": "EGP 5000", "expected": { "ok": true, "piastres": 500000 } },
    { "input": "5000 جنيه", "expected": { "ok": true, "piastres": 500000 } },
    { "input": "٥٠٠٠ ج", "expected": { "ok": true, "piastres": 500000 } },
    { "input": "450 LE", "expected": { "ok": true, "piastres": 45000 } },
    { "input": "١٬٢٥٠", "expected": { "ok": true, "piastres": 125000 } },
    { "input": "٨٥٫٥٠", "expected": { "ok": true, "piastres": 8550 } },
    { "input": "1,250.75", "expected": { "ok": true, "piastres": 125075 } },
    { "input": "1,000,000", "expected": { "ok": true, "piastres": 100000000 } },
    { "input": " 85.5 ", "expected": { "ok": true, "piastres": 8550 } },
    { "input": "0", "expected": { "ok": true, "piastres": 0 } },
    { "input": "", "expected": { "ok": false, "reason": "empty" } },
    { "input": "   ", "expected": { "ok": false, "reason": "empty" } },
    { "input": "جنيه", "expected": { "ok": false, "reason": "empty" } },
    { "input": "later", "expected": { "ok": false, "reason": "invalid" }, "note": "the onboarding step handles 'later' itself" },
    { "input": "abc", "expected": { "ok": false, "reason": "invalid" } },
    { "input": "5,00", "expected": { "ok": false, "reason": "invalid" }, "note": "comma is a thousands separator only" },
    { "input": "12.345", "expected": { "ok": false, "reason": "invalid" } },
    { "input": "2.55k", "expected": { "ok": false, "reason": "invalid" } },
    { "input": "-100", "expected": { "ok": false, "reason": "invalid" } },
    { "input": "5000 or 6000", "expected": { "ok": false, "reason": "invalid" } },
    { "input": "100000000000", "expected": { "ok": false, "reason": "too_large" } }
  ],
  "format_money": [
    { "piastres": 125000, "lang": "en", "expected": "1,250 EGP" },
    { "piastres": 125000, "lang": "ar", "expected": "١٬٢٥٠ جنيه" },
    { "piastres": 8550, "lang": "en", "expected": "85.50 EGP" },
    { "piastres": 8550, "lang": "ar", "expected": "٨٥٫٥٠ جنيه" },
    { "piastres": 0, "lang": "en", "expected": "0 EGP" },
    { "piastres": 5, "lang": "en", "expected": "0.05 EGP" },
    { "piastres": 100000000, "lang": "en", "expected": "1,000,000 EGP" },
    { "piastres": 99900, "lang": "ar", "expected": "٩٩٩ جنيه" },
    { "piastres": -30000, "lang": "en", "expected": "-300 EGP" }
  ]
}
