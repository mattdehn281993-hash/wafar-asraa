{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wafar-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "codebase", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "wafar-pages-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "codebase", "run", "preview", "--", "--port", "4173", "--strictPort"],
      "env": { "BASE_PATH": "/Wafar-Asraa/" },
      "port": 4173
    },
    {
      "name": "wafar-backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "wafar-backend/backend", "run", "dev"],
      "port": 8080
    }
  ]
}
