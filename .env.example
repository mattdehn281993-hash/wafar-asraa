# This file is committed: keep real values in .env only (Copy-Item .env.example .env).

# Supabase dashboard > Connect > Connection string > "Session pooler" (port 5432, not 6543).
# Looks like postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The password is the database password, not an API key (reset it in Project Settings > Database).
DATABASE_URL=
# Project Settings > API (or Data API): the project URL, https://<project-ref>.supabase.co
SUPABASE_URL=
# Project Settings > API Keys: the service_role key (or the newer sb_secret_ key). Not the anon key.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
CLAUDE_RECEIPT_MODEL=claude-haiku-5-5
CLAUDE_CHAT_MODEL=claude-haiku-5-5
WHAPI_API_URL=https://gate.whapi.cloud/
WHAPI_TOKEN=
WHAPI_WEBHOOK_SECRET=
STT_PROVIDER=google
GOOGLE_APPLICATION_CREDENTIALS=
APP_ENV=local
# Investor web demo endpoints (POST /demo/shopping-list, uses ANTHROPIC_API_KEY and CLAUDE_RECEIPT_MODEL).
# Leave empty: on only when APP_ENV=local. Set true/false to override.
DEMO_API_ENABLED=
LOG_LEVEL=info
PORT=8080
ADMIN_PASSWORD=
